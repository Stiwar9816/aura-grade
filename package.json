{
  "name": "aura_grade",
  "version": "1.0.0",
  "description": "",
  "author": "Stiwar Asprilla <stiwar.asprilla1998@gmail.com>",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start -b swc",
    "start:dev": "nest start -b swc -w",
    "start:debug": "nest start -b swc --debug -w",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:clear": "jest --clearCache",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/config/datasource.config.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/config/datasource.config.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/config/datasource.config.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/config/datasource.config.ts",
    "migration:show:prod": "typeorm migration:show -d dist/config/datasource.config.js",
    "migration:run:prod": "typeorm migration:run -d dist/config/datasource.config.js",
    "seed:dev": "ts-node -r tsconfig-paths/register src/seed/run-seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
